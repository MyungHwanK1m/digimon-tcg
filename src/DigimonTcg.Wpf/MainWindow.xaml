<Window x:Class="DigimonTcg.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DIGIMON TCG : DIGITAL COLOSSEUM (실전 AI 듀얼 아레나 &amp; 솔리테어 훈련소 &amp; 카드 도감)"
        Icon="pack://application:,,,/Assets/DigimonTcg.ico"
        Height="960" Width="1600"
        MinHeight="800" MinWidth="1280"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        PreviewMouseMove="Window_PreviewMouseMove"
        PreviewMouseLeftButtonUp="Window_PreviewMouseLeftButtonUp"
        Background="#0B0E17">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 상단 헤더 & 3대 메인 모드 전환 바 -->
        <Border Grid.Row="0" Background="#111524" BorderBrush="#2A324B" BorderThickness="0,0,0,1.5" Padding="18,9">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <Border Background="#F38BA8" CornerRadius="6" Padding="8,3" Margin="0,0,10,0" VerticalAlignment="Center">
                        <TextBlock Text="DIGIMON TCG" Foreground="#11111B" FontSize="14" FontWeight="ExtraBold"/>
                    </Border>
                    <TextBlock Text="DIGITAL COLOSSEUM" Foreground="#F8FAFC" FontSize="19" FontWeight="ExtraBold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock x:Name="TxtCurrentModeSubtitle" Text="⚔️ 실전 AI 듀얼 아레나 — 공식 룰 플레이매트 대전" Foreground="#89DCEB" FontSize="13.5" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button x:Name="BtnTabOfficialMatch" Content="⚔️ 실전 AI 듀얼 아레나" Click="BtnTabOfficialMatch_Click"
                            Background="#F38BA8" Foreground="#11111B" FontWeight="ExtraBold" FontSize="12.5" Padding="15,7" Margin="0,0,8,0" BorderThickness="0" Cursor="Hand"/>
                    <Button x:Name="BtnTabSimulator" Content="🎯 1인 솔리테어 훈련소" Click="BtnTabSimulator_Click"
                            Background="#25293E" Foreground="#CDD6F4" FontWeight="Bold" FontSize="12.5" Padding="15,7" Margin="0,0,8,0" BorderThickness="0" Cursor="Hand"/>
                    <Button x:Name="BtnTabDeckBuilder" Content="📚 디지털 카드 도감 &amp; 덱 공방" Click="BtnTabDeckBuilder_Click"
                            Background="#25293E" Foreground="#CDD6F4" FontWeight="Bold" FontSize="12.5" Padding="15,7" BorderThickness="0" Cursor="Hand"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 실시간 ActionValidator 가이드 & 토스트 피드백 배너 -->
        <Border x:Name="ToastBanner" Grid.Row="1" Background="#162032" BorderBrush="#38BDF8" BorderThickness="0,0,0,2" Padding="18,6">
            <DockPanel>
                <TextBlock x:Name="ToastBadge" Text="💡 가이드" Foreground="#38BDF8" FontWeight="Bold" FontSize="12.5" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <TextBlock x:Name="ToastMessageText"
                           Text="실전 플레이매트 화면입니다! 패의 카드를 마우스로 끌어(드래그) 필드 디지몬 위에 놓으면 [진화], 빈 배틀 에어리어에 놓으면 [등장]합니다."
                           Foreground="#F8FAFC" FontSize="12.5" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </DockPanel>
        </Border>

        <!-- 메인 컨텐츠 영역 (플레이매트 뷰 / 덱 공방 뷰 + 공통 우측 카드 인스펙터) -->
        <Grid Grid.Row="2" Margin="10,8,10,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="345"/>
            </Grid.ColumnDefinitions>

            <!-- 좌측 메인 작업 영역 -->
            <Grid Grid.Column="0" Margin="0,0,10,0">
                <!-- ==================== VIEW 1 & 2: 공식 디지몬 TCG 플레이매트 필드 (AI 듀얼 아레나 & 1인 솔리테어 훈련소) ==================== -->
                <Grid x:Name="SimulatorView" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <!-- Row 0: 상단 상대방 플레이매트 진영 (좌: 상대 시큐리티 5장 / 우: 상대 배틀 에어리어) -->
                        <RowDefinition Height="Auto"/>
                        <!-- Row 1: 중앙 메모리 게이지 & 턴/페이즈 컨트롤 바 (실제 플레이매트 중앙선) -->
                        <RowDefinition Height="Auto"/>
                        <!-- Row 2: 중단 내 플레이매트 진영 (좌: 내 시큐리티 & 육성존 / 중: 내 배틀 에어리어 & 테이머 / 우: 덱 & 트래시) -->
                        <RowDefinition Height="*"/>
                        <!-- Row 3: 하단 내 손패 (Player Hand) -->
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- ==================== [ROW 0] 상단 상대방 플레이매트 진영 (OPPONENT SIDE) ==================== -->
                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="470"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 좌상단: 상대 시큐리티 스택 (OPPONENT SECURITY STACK) -->
                        <Border x:Name="OpponentSecurityZoneBorder" Grid.Column="0" Background="#151324" CornerRadius="9" BorderBrush="#F38BA8" BorderThickness="1.5" Padding="9,6" Margin="0,0,6,0">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,4">
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                        <TextBlock Text="🛡️ 상대 시큐리티" Foreground="#F38BA8" FontWeight="ExtraBold" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <Border Background="#0F101A" BorderBrush="#45475A" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="0,0,6,0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="TxtSecurityProgressLabel" Text="0/5 돌파" Foreground="#F9E2AF" FontWeight="Bold" FontSize="10.5" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                <ProgressBar x:Name="BarSecurityProgress" Width="55" Height="7" Minimum="0" Maximum="5" Value="0" Background="#313244" Foreground="#A6E3A1" BorderThickness="0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                        <Button x:Name="BtnToggleSecurityPeek" Content="🙈 앞면보기: OFF" Click="BtnToggleSecurityPeek_Click"
                                                Background="#45475A" Foreground="#F8FAFC" FontWeight="Bold" FontSize="10" Padding="6,2" BorderThickness="0" Cursor="Hand"/>
                                    </StackPanel>
                                </DockPanel>

                                <DockPanel Margin="0,0,0,4">
                                    <TextBlock x:Name="TxtNextSecurityTarget" Text="🎯 다음 시큐리티: -" Foreground="#89DCEB" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtLastSecurityBattle" Text="배틀 대기 중" Foreground="#A6ADC8" FontWeight="SemiBold" FontSize="10.5" HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>

                                <ScrollViewer x:Name="OpponentSecurityScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                    <StackPanel x:Name="OpponentSecurityPanel" Orientation="Horizontal"/>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>

                        <!-- 우상단: 상대 배틀 에어리어 & 상대 덱/패/테이머 정보 (OPPONENT BATTLE AREA) -->
                        <Border x:Name="OpponentBattleAreaBorder" Grid.Column="1" Visibility="Visible"
                                Background="#191326" CornerRadius="9" BorderBrush="#FAB387" BorderThickness="1.5" Padding="10,6">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                                    <TextBlock x:Name="TxtOpponentFieldHeader" Text="👾 상대 배틀 에어리어 (OPPONENT BATTLE AREA)"
                                               Foreground="#FAB387" FontWeight="ExtraBold" FontSize="12.5"/>
                                    <TextBlock x:Name="TxtOpponentZonesSummary" Text="상대 필드: 1마리 | 상대 패: 5장" Foreground="#A6ADC8" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Right"/>
                                </DockPanel>
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                    <StackPanel x:Name="OpponentBattleAreaPanel" Orientation="Horizontal" MinHeight="92"/>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </Grid>

                    <!-- ==================== [ROW 1] 플레이매트 중앙 메모리 게이지 & 턴 컨트롤러 (CENTER MEMORY GAUGE) ==================== -->
                    <Border Grid.Row="1" Background="#141829" CornerRadius="9" BorderBrush="#38BDF8" BorderThickness="1.5" Padding="10,6" Margin="0,0,0,6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- 상단 줄: 턴 배지 + 페이즈 표시 + 모드별 스테이지 전환 + 우측 컨트롤 버튼 -->
                            <DockPanel Grid.Row="0" Margin="0,0,0,5">
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                    <Border Background="#CBA6F7" CornerRadius="5" Padding="9,2" Margin="0,0,8,0">
                                        <TextBlock x:Name="TxtTurnBadge" Text="TURN 1" Foreground="#11111B" FontWeight="ExtraBold" FontSize="12.5"/>
                                    </Border>
                                    <StackPanel x:Name="PhaseStepPanel" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0"/>

                                    <!-- 1인 훈련소 모드일 때 표시되는 세부 스테이지 선택 -->
                                    <StackPanel x:Name="SoloStageButtonsPanel" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button x:Name="BtnStage1" Content="🐣 Stage 1: 5턴 솔리테어" Click="BtnStage1_Click"
                                                Background="#313244" Foreground="#CDD6F4" FontWeight="Bold" FontSize="10.5" Padding="7,3" Margin="0,0,4,0" BorderThickness="0" Cursor="Hand"/>
                                        <Button x:Name="BtnStage2" Content="🛡️ Stage 2: 블로커 돌파" Click="BtnStage2_Click"
                                                Background="#313244" Foreground="#CDD6F4" FontWeight="Bold" FontSize="10.5" Padding="7,3" Margin="0,0,4,0" BorderThickness="0" Cursor="Hand"/>
                                        <Button x:Name="BtnStage3" Content="⚔️ Stage 3: 실전 AI 대전" Click="BtnStage3_Click"
                                                Background="#F38BA8" Foreground="#11111B" FontWeight="ExtraBold" FontSize="10.5" Padding="7,3" BorderThickness="0" Cursor="Hand"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtMemoryStatus" Text="현재 메모리: +3" Foreground="#89DCEB" FontSize="12" FontWeight="ExtraBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <Button x:Name="BtnMulligan" Content="🔄 멀리건(손패교체)" Click="BtnMulligan_Click"
                                            Background="#CBA6F7" Foreground="#11111B" FontWeight="Bold" FontSize="10.5" Padding="7,3" Margin="0,0,4,0" BorderThickness="0" Cursor="Hand"/>
                                    <Button Content="🔥 ST-1 레드 덱" Click="BtnStartSt1_Click" Background="#F38BA8" Foreground="#11111B" FontWeight="Bold" FontSize="10.5" Padding="7,3" Margin="0,0,4,0" BorderThickness="0" Cursor="Hand"/>
                                    <Button Content="❄️ ST-2 블루 덱" Click="BtnStartSt2_Click" Background="#89B4FA" Foreground="#11111B" FontWeight="Bold" FontSize="10.5" Padding="7,3" Margin="0,0,6,0" BorderThickness="0" Cursor="Hand"/>
                                    <Button Content="⏭️ 육성 패스" x:Name="BtnPassBreeding" Click="BtnPassBreeding_Click" Background="#F9E2AF" Foreground="#11111B" FontWeight="Bold" FontSize="10.5" Padding="7,3" Margin="0,0,4,0" BorderThickness="0" Cursor="Hand"/>
                                    <Button Content="🛑 턴 종료 (Pass)" Click="BtnPassTurn_Click" Background="#FAB387" Foreground="#11111B" FontWeight="ExtraBold" FontSize="10.5" Padding="8,3" BorderThickness="0" Cursor="Hand"/>
                                </StackPanel>
                            </DockPanel>

                            <!-- 하단 줄: 플레이매트 중앙 메모리 게이지 (-10 ~ +10) -->
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="🟦 PLAYER (+10)" Foreground="#89B4FA" FontWeight="ExtraBold" FontSize="10.5" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <UniformGrid x:Name="MemoryGaugeGrid" Grid.Column="1" Rows="1" Columns="21" Height="24"/>
                                <TextBlock Grid.Column="2" Text="(-10) OPPONENT 🟥" Foreground="#F38BA8" FontWeight="ExtraBold" FontSize="10.5" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- ==================== [ROW 2] 중단 내 플레이매트 진영 (좌: 내 시큐리티 & 육성존 / 중: 내 배틀 에어리어 / 우: 내 덱 & 트래시) ==================== -->
                    <Grid Grid.Row="2" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="246"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="154"/>
                        </Grid.ColumnDefinitions>

                        <!-- [좌측 구역] 내 시큐리티 스택 (상) + 육성 에어리어 (하) -->
                        <Grid Grid.Column="0" Margin="0,0,6,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- 1) 내 시큐리티 존 (MY SECURITY STACK) -->
                            <Border Grid.Row="0" Background="#13192B" CornerRadius="8" BorderBrush="#38BDF8" BorderThickness="1.5" Padding="8,6" Margin="0,0,0,6">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,4">
                                        <TextBlock Text="🛡️ 내 시큐리티 존" Foreground="#38BDF8" FontWeight="ExtraBold" FontSize="12.5"/>
                                        <TextBlock x:Name="TxtMySecurityCountBadge" Text="5 / 5장" Foreground="#F9E2AF" FontWeight="ExtraBold" FontSize="12" HorizontalAlignment="Right"/>
                                    </DockPanel>
                                    <!-- 내 시큐리티 5장 시각적 미니 스택 -->
                                    <UniformGrid x:Name="MySecurityVisualStack" Rows="1" Columns="5" Height="32" Margin="0,0,0,4"/>
                                    <TextBlock x:Name="TxtMySecurityLastEvent" Text="덱 맨 위 5장 무작위 배치됨" Foreground="#A6ADC8" FontSize="10.5" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- 2) 내 육성 에어리어 (BREEDING AREA) -->
                            <Border x:Name="BreedingAreaZoneBorder" Grid.Row="1" Background="#131D24" CornerRadius="8" BorderBrush="#A6E3A1" BorderThickness="1.5" Padding="8">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,5">
                                        <DockPanel>
                                            <TextBlock Text="🥚 육성 에어리어" Foreground="#A6E3A1" FontWeight="ExtraBold" FontSize="12.5"/>
                                            <TextBlock x:Name="TxtDigitamaCount" Text="디지타마: 4장" Foreground="#A6ADC8" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </DockPanel>
                                        <UniformGrid Rows="1" Columns="2" Margin="0,4,0,0">
                                            <Button x:Name="BtnHatch" Content="🥚 부화 (Lv.2)" Click="BtnHatch_Click"
                                                    Background="#A6E3A1" Foreground="#11111B" FontWeight="ExtraBold" FontSize="11" Padding="4,4" Margin="0,0,2,0" BorderThickness="0" Cursor="Hand"/>
                                            <Button x:Name="BtnMoveBreeding" Content="🚀 배틀 이동" Click="BtnMoveBreeding_Click"
                                                    Background="#89DCEB" Foreground="#11111B" FontWeight="ExtraBold" FontSize="11" Padding="4,4" Margin="2,0,0,0" BorderThickness="0" Cursor="Hand"/>
                                        </UniformGrid>
                                    </StackPanel>

                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <ContentControl x:Name="BreedingSlotControl" HorizontalAlignment="Center"/>
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>
                        </Grid>

                        <!-- [중앙 구역] 내 배틀 에어리어 & 테이머 존 (MY BATTLE AREA & TAMERS) -->
                        <Border x:Name="BattleAreaZoneBorder" Grid.Column="1" Background="#131726" CornerRadius="9" BorderBrush="#89B4FA" BorderThickness="1.5" Padding="10" Margin="0,0,6,0">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                    <TextBlock Text="⚔️ 내 배틀 에어리어 (BATTLE AREA)" Foreground="#89B4FA" FontWeight="ExtraBold" FontSize="13.5" VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtSelectedTarget" Text="🖱️ 패의 카드를 드래그해서 디지몬 위에 놓으면 [진화], 빈 필드에 놓으면 [등장]합니다!" Foreground="#F9E2AF" FontWeight="Bold" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <Button x:Name="BtnCancelPendingAction" Content="❌ 선택 취소" Click="BtnCancelPendingAction_Click" Visibility="Collapsed"
                                                Background="#F38BA8" Foreground="#11111B" FontWeight="Bold" FontSize="11" Padding="8,2" BorderThickness="0" Cursor="Hand"/>
                                    </StackPanel>
                                </DockPanel>

                                <!-- 하단 테이머 존 바 -->
                                <Border DockPanel.Dock="Bottom" Background="#0E111D" BorderBrush="#2A324B" BorderThickness="1" CornerRadius="6" Padding="8,5" Margin="0,6,0,0">
                                    <DockPanel>
                                        <StackPanel x:Name="TamerZonePanel" Orientation="Horizontal" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtPlayerZonesSummary" Text="메인 덱: 40장 | 내 시큐리티: 5장 | 트래시: 0장" Foreground="#A6ADC8" FontSize="10.5" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed"/>
                                    </DockPanel>
                                </Border>

                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                    <WrapPanel x:Name="BattleAreaPanel" Orientation="Horizontal"/>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>

                        <!-- [우측 구역] 실제 플레이매트 우측의 내 메인 덱 & 트래시 존 (MAIN DECK & TRASH) -->
                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- 상단: 메인 덱 (MAIN DECK) -->
                            <Border Grid.Row="0" Background="#131726" CornerRadius="8" BorderBrush="#45475A" BorderThickness="1.5" Padding="8" Margin="0,0,0,6">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="🗂️ MAIN DECK" Foreground="#89DCEB" FontWeight="ExtraBold" FontSize="11.5" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                    <Border Width="76" Height="102" CornerRadius="6" BorderBrush="#38BDF8" BorderThickness="2" HorizontalAlignment="Center">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#1E3A8A" Offset="0"/>
                                                <GradientStop Color="#0F172A" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock Text="DIGIMON" Foreground="#38BDF8" FontWeight="ExtraBold" FontSize="10" HorizontalAlignment="Center"/>
                                            <TextBlock x:Name="TxtMainDeckVisualCount" Text="40장" Foreground="#F8FAFC" FontWeight="ExtraBold" FontSize="16" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="매 턴 1드로우 / 진화 1드로우" Foreground="#6C7086" FontSize="9.5" HorizontalAlignment="Center" Margin="0,5,0,0" TextAlignment="Center" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- 하단: 트래시 (TRASH / 묘지) -->
                            <Border x:Name="PlayerTrashZoneBorder" Grid.Row="1" Background="#131726" CornerRadius="8" BorderBrush="#45475A" BorderThickness="1.5" Padding="8">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="🗑️ TRASH (묘지)" Foreground="#F38BA8" FontWeight="ExtraBold" FontSize="11.5" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                    <TextBlock x:Name="TxtTrashVisualCount" Text="0장" Foreground="#F9E2AF" FontWeight="ExtraBold" FontSize="13" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                    <ContentControl x:Name="TrashTopCardControl" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- ==================== [ROW 3] 하단 플레이어 손패 (PLAYER HAND) ==================== -->
                    <Border Grid.Row="3" Background="#141726" CornerRadius="9" BorderBrush="#F9E2AF" BorderThickness="1.5" Padding="10,7">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,5">
                                <TextBlock x:Name="TxtHandHeader" Text="🃏 내 손패 (Hand: 5장)" Foreground="#F9E2AF" FontWeight="ExtraBold" FontSize="13.5"/>
                                <TextBlock Text="🖱️ 카드를 마우스로 끌어(드래그) 필드 디지몬 위에 놓으면 [🧬진화/효과], 배틀 에어리어 빈 곳에 놓으면 [✨등장]!" Foreground="#A6E3A1" FontWeight="Bold" FontSize="11.5" HorizontalAlignment="Right"/>
                            </DockPanel>
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <StackPanel x:Name="HandPanel" Orientation="Horizontal"/>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Grid>

                <!-- ==================== VIEW 2: 카드 도감 & 덱 빌더 ==================== -->
                <Grid x:Name="DeckBuilderView" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="390"/>
                    </Grid.ColumnDefinitions>

                    <!-- 좌측: 검색/필터 바 & 실물 카드 도감 그리드 -->
                    <Border Grid.Column="0" Background="#181825" CornerRadius="8" BorderBrush="#313244" BorderThickness="1" Padding="12" Margin="0,0,10,0">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Background="#1E1E2E" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                                <WrapPanel VerticalAlignment="Center">
                                    <TextBlock Text="🔍 검색:" Foreground="#CDD6F4" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBox x:Name="TxtSearchKeyword" Width="150" Padding="6,4" Margin="0,0,10,0" Background="#11111B" Foreground="#F8FAFC" BorderBrush="#45475A" TextChanged="FilterChanged"/>

                                    <TextBlock Text="색상:" Foreground="#CDD6F4" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <ComboBox x:Name="CmbFilterColor" Width="85" Margin="0,0,10,0" SelectionChanged="FilterChanged" SelectedIndex="0">
                                        <ComboBoxItem Content="전체"/>
                                        <ComboBoxItem Content="Red"/>
                                        <ComboBoxItem Content="Blue"/>
                                        <ComboBoxItem Content="Yellow"/>
                                        <ComboBoxItem Content="Green"/>
                                        <ComboBoxItem Content="White"/>
                                    </ComboBox>

                                    <TextBlock Text="종류:" Foreground="#CDD6F4" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <ComboBox x:Name="CmbFilterType" Width="95" Margin="0,0,10,0" SelectionChanged="FilterChanged" SelectedIndex="0">
                                        <ComboBoxItem Content="전체"/>
                                        <ComboBoxItem Content="Digitama"/>
                                        <ComboBoxItem Content="Digimon"/>
                                        <ComboBoxItem Content="Tamer"/>
                                        <ComboBoxItem Content="Option"/>
                                    </ComboBox>

                                    <TextBlock Text="레벨:" Foreground="#CDD6F4" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <ComboBox x:Name="CmbFilterLevel" Width="75" Margin="0,0,10,0" SelectionChanged="FilterChanged" SelectedIndex="0">
                                        <ComboBoxItem Content="전체"/>
                                        <ComboBoxItem Content="Lv.2"/>
                                        <ComboBoxItem Content="Lv.3"/>
                                        <ComboBoxItem Content="Lv.4"/>
                                        <ComboBoxItem Content="Lv.5"/>
                                        <ComboBoxItem Content="Lv.6"/>
                                        <ComboBoxItem Content="Lv.7"/>
                                    </ComboBox>

                                    <Button x:Name="BtnSyncApi" Content="🌐 API 동기화" Click="BtnSyncApi_Click"
                                            Background="#89DCEB" Foreground="#11111B" FontWeight="Bold" Padding="9,4" BorderThickness="0" Cursor="Hand"/>
                                </WrapPanel>
                            </Border>

                            <TextBlock x:Name="TxtCatalogCount" DockPanel.Dock="Top" Text="카드 도감 목록" Foreground="#A6ADC8" FontSize="12" Margin="0,0,0,8"/>

                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <WrapPanel x:Name="CatalogWrapPanel" Orientation="Horizontal"/>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>

                    <!-- 우측: 황금 비율 HUD & 현재 덱 구성 -->
                    <Border Grid.Column="1" Background="#181825" CornerRadius="8" BorderBrush="#313244" BorderThickness="1" Padding="12">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                <TextBlock Text="🛠️ 스타터 덱 프리셋 &amp; 관리" Foreground="#F9E2AF" FontWeight="Bold" FontSize="14.5" Margin="0,0,0,6"/>
                                <UniformGrid Rows="2" Columns="2" Margin="0,0,0,6">
                                    <Button Content="🔥 ST-1 가이아 레드" Click="BtnLoadPresetSt1_Click" Background="#F38BA8" Foreground="#11111B" FontWeight="Bold" Padding="6,5" Margin="0,0,3,3" BorderThickness="0" Cursor="Hand"/>
                                    <Button Content="❄️ ST-2 코큐토스 블루" Click="BtnLoadPresetSt2_Click" Background="#89B4FA" Foreground="#11111B" FontWeight="Bold" Padding="6,5" Margin="3,0,0,3" BorderThickness="0" Cursor="Hand"/>
                                    <Button Content="💾 커스텀 덱 저장" Click="BtnSaveCustomDeck_Click" Background="#A6E3A1" Foreground="#11111B" FontWeight="Bold" Padding="6,5" Margin="0,3,3,0" BorderThickness="0" Cursor="Hand"/>
                                    <Button Content="📂 저장된 덱 로드" Click="BtnLoadCustomDeck_Click" Background="#CBA6F7" Foreground="#11111B" FontWeight="Bold" Padding="6,5" Margin="3,3,0,0" BorderThickness="0" Cursor="Hand"/>
                                </UniformGrid>
                                <UniformGrid Rows="1" Columns="2">
                                    <Button Content="🗑️ 덱 초기화" Click="BtnClearDeck_Click" Background="#45475A" Foreground="#F8FAFC" FontWeight="Bold" Padding="6,5" Margin="0,0,3,0" BorderThickness="0" Cursor="Hand"/>
                                    <Button Content="▶️ 이 덱으로 연습 시작!" Click="BtnPlayWithCurrentDeck_Click" Background="#F9E2AF" Foreground="#11111B" FontWeight="ExtraBold" Padding="6,5" Margin="3,0,0,0" BorderThickness="0" Cursor="Hand"/>
                                </UniformGrid>
                            </StackPanel>

                            <Border DockPanel.Dock="Top" Background="#11111B" CornerRadius="6" BorderBrush="#45475A" BorderThickness="1" Padding="10" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="📊 초심자 권장 덱 비율 (황금 비율 HUD)" Foreground="#89DCEB" FontWeight="Bold" FontSize="12.5" Margin="0,0,0,6"/>
                                    <StackPanel x:Name="GoldenRatioHudPanel"/>
                                    <TextBlock x:Name="TxtDeckValidationStatus" Text="✅ 덱 검증 통과" Foreground="#A6E3A1" FontWeight="Bold" FontSize="11.5" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <DockPanel>
                                <TextBlock x:Name="TxtDeckListHeader" DockPanel.Dock="Top" Text="📋 현재 덱 구성" Foreground="#CDD6F4" FontWeight="Bold" FontSize="12.5" Margin="0,0,0,6"/>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="CurrentDeckListPanel"/>
                                </ScrollViewer>
                            </DockPanel>
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- ==================== 우측 고정 사이드바: 실물 카드 확대 프리뷰 & 타임어택 HUD / 로그 ==================== -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 1) 실물 카드 디자인 고해상도 확대 프리뷰 (Card Design Inspector) -->
                <Border Grid.Row="0" Background="#181825" CornerRadius="8" BorderBrush="#F9E2AF" BorderThickness="1.5" Padding="10" Margin="0,0,0,8">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock Text="🔍 카드 디자인 &amp; 효과 상세 프리뷰" Foreground="#F9E2AF" FontWeight="Bold" FontSize="13.5"/>
                            <TextBlock x:Name="TxtInspectorId" Text="ST1-11" Foreground="#A6ADC8" FontWeight="Bold" FontSize="12" HorizontalAlignment="Right"/>
                        </DockPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="152"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- 좌측: 실물 TCG 카드 이미지 프레임 -->
                            <Border x:Name="InspectorCardFrame" Grid.Column="0" Width="146" Height="204" CornerRadius="8"
                                    BorderBrush="#F38BA8" BorderThickness="2" Background="#11111B" HorizontalAlignment="Left" ClipToBounds="True">
                                <Grid>
                                    <Image x:Name="ImgInspectorCard" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <Border x:Name="InspectorFallbackPanel" Background="#1E1E2E" Visibility="Collapsed" Padding="8">
                                        <TextBlock x:Name="TxtInspectorFallback" Foreground="#F8FAFC" FontWeight="Bold" TextAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- 우측: 한글 카드 스탯 & 효과 설명 -->
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <Border x:Name="InspectorColorBadge" Background="#F38BA8" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" Margin="0,0,0,4">
                                    <TextBlock x:Name="TxtInspectorBadge" Text="Lv.6 Red Digimon" Foreground="#11111B" FontWeight="Bold" FontSize="11"/>
                                </Border>
                                <TextBlock x:Name="TxtInspectorName" Text="워그레이몬" Foreground="#F8FAFC" FontWeight="ExtraBold" FontSize="16" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                <TextBlock x:Name="TxtInspectorStats" Text="등장: 12 | 진화: 4 (Lv.5)&#x0a;기본 DP: 12000" Foreground="#89DCEB" FontWeight="SemiBold" FontSize="11.5" Margin="0,0,0,6"/>

                                <Border Background="#11111B" CornerRadius="4" Padding="6" Margin="0,0,0,4">
                                    <StackPanel>
                                        <TextBlock Text="[메인 효과]" Foreground="#F9E2AF" FontWeight="Bold" FontSize="10.5"/>
                                        <TextBlock x:Name="TxtInspectorEffect" Text="-" Foreground="#CDD6F4" FontSize="11" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="#11111B" CornerRadius="4" Padding="6">
                                    <StackPanel>
                                        <TextBlock Text="[진화원 효과]" Foreground="#A6E3A1" FontWeight="Bold" FontSize="10.5"/>
                                        <TextBlock x:Name="TxtInspectorInherited" Text="-" Foreground="#CDD6F4" FontSize="11" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 2) 타임어택 & 평가 지표 HUD -->
                <Border Grid.Row="1" Background="#181825" CornerRadius="8" BorderBrush="#CBA6F7" BorderThickness="1" Padding="10" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="⏱️ 타임어택 &amp; 평가 지표 HUD" Foreground="#CBA6F7" FontWeight="Bold" FontSize="13.5" Margin="0,0,0,6"/>
                        <Border Background="#11111B" CornerRadius="6" Padding="8" Margin="0,0,0,5">
                            <StackPanel>
                                <TextBlock x:Name="TxtHudTurn" Text="• 현재 진행 턴: 1 / 5턴 (목표: 5턴 이내 킬)" Foreground="#89DCEB" FontSize="11.5" Margin="0,1"/>
                                <TextBlock x:Name="TxtHudSecurity" Text="• 남은 더미 시큐리티: 5 / 5장" Foreground="#F38BA8" FontSize="11.5" Margin="0,1"/>
                                <TextBlock x:Name="TxtHudEvoRate" Text="• 진화 체인 성공률 (Lv.3→Lv.6): 0.0% (0/0)" Foreground="#A6E3A1" FontSize="11.5" Margin="0,1"/>
                                <TextBlock x:Name="TxtHudMemoryEff" Text="• 턴당 메모리 사용 효율: 0.0 메모리/턴" Foreground="#F9E2AF" FontSize="11.5" Margin="0,1"/>
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="TxtGameResultBanner" Text="진행 중: 육성/진화로 킬 각을 만들어보세요!" Foreground="#CDD6F4" FontWeight="Bold" FontSize="11.5" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- 3) 실시간 게임 & 검증 로그 -->
                <Border Grid.Row="2" Background="#181825" CornerRadius="8" BorderBrush="#313244" BorderThickness="1" Padding="10">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="📜 인게임 진행 &amp; 룰 엔진 로그" Foreground="#89B4FA" FontWeight="Bold" FontSize="13" Margin="0,0,0,6"/>
                        <ListBox x:Name="LstActionLogs" Background="#11111B" Foreground="#CDD6F4" BorderThickness="0" FontSize="11.5"/>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- 드래그 앤 드롭 플로팅 카드 고스트 오버레이 -->
        <Canvas x:Name="DragOverlayCanvas" Grid.Row="0" Grid.RowSpan="3" Panel.ZIndex="999" IsHitTestVisible="False" Visibility="Collapsed"/>
    </Grid>
</Window>
