<!--
    ============================================================================================
     CYBER NEO 디자인 테마 (docs/design_revamp_plan.md · Phase 1)
     - 1. 색상 팔레트 (Color)
     - 2. 단색/그라디언트 브러시 (Brush) : 사이버 매트, 그리드 라인, 글래스, 메모리 코어, 카드 색상
     - 3. 네온 글로우 이펙트 (DropShadowEffect)
     - 4. 공통 치수 (CornerRadius / Thickness / FontFamily)
     - 5. 텍스트 · 패널 스타일 (키 지정)
     - 6. 컨트롤 스타일 : Button(기본 암시적 + 네온 변형), ComboBox, ScrollBar, ToolTip, ProgressBar
     키 규칙: Neo.{분류}.{이름}[.{변형}]
    ============================================================================================
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    mc:Ignorable="po"
                    xmlns:themes="clr-namespace:DigimonTcg.Wpf.Themes">

    <!-- ==================== 1. 색상 팔레트 ==================== -->
    <!-- 베이스 (어두운 순) -->
    <Color x:Key="Neo.Color.Void">#05070D</Color>
    <Color x:Key="Neo.Color.Mat">#090C15</Color>
    <Color x:Key="Neo.Color.Surface">#101423</Color>
    <Color x:Key="Neo.Color.SurfaceRaised">#181D30</Color>
    <Color x:Key="Neo.Color.SurfaceInput">#0E111B</Color>
    <Color x:Key="Neo.Color.Line">#26304A</Color>
    <Color x:Key="Neo.Color.LineStrong">#3A4566</Color>

    <!-- 텍스트 -->
    <Color x:Key="Neo.Color.Text.Primary">#F8FAFC</Color>
    <Color x:Key="Neo.Color.Text.Secondary">#CDD6F4</Color>
    <Color x:Key="Neo.Color.Text.Muted">#A6ADC8</Color>
    <Color x:Key="Neo.Color.Text.Dim">#6C7086</Color>
    <Color x:Key="Neo.Color.Text.OnNeon">#11111B</Color>

    <!-- 네온 액센트 : 내 진영(시안) / 상대 진영(로즈) / 보조 -->
    <Color x:Key="Neo.Color.Cyan">#38BDF8</Color>
    <Color x:Key="Neo.Color.CyanBright">#7DE3FF</Color>
    <Color x:Key="Neo.Color.Rose">#F43F75</Color>
    <Color x:Key="Neo.Color.RoseSoft">#F38BA8</Color>
    <Color x:Key="Neo.Color.Gold">#F9E2AF</Color>
    <Color x:Key="Neo.Color.Green">#A6E3A1</Color>
    <Color x:Key="Neo.Color.Violet">#CBA6F7</Color>
    <Color x:Key="Neo.Color.Orange">#FAB387</Color>

    <!-- 글래스 (반투명) -->
    <Color x:Key="Neo.Color.Glass.Top">#B81A2036</Color>
    <Color x:Key="Neo.Color.Glass.Bottom">#9E0C1020</Color>
    <Color x:Key="Neo.Color.Glass.EdgeLight">#4DFFFFFF</Color>
    <Color x:Key="Neo.Color.Glass.EdgeDark">#0FFFFFFF</Color>

    <!-- 카드 색상 (기존 GetCardColorBrush 와 동일 값 유지) -->
    <Color x:Key="Neo.Color.Card.Red">#F38BA8</Color>
    <Color x:Key="Neo.Color.Card.Blue">#89B4FA</Color>
    <Color x:Key="Neo.Color.Card.Yellow">#F9E2AF</Color>
    <Color x:Key="Neo.Color.Card.Green">#A6E3A1</Color>
    <Color x:Key="Neo.Color.Card.Black">#94A3B8</Color>
    <Color x:Key="Neo.Color.Card.Purple">#CBA6F7</Color>
    <Color x:Key="Neo.Color.Card.White">#F8FAFC</Color>
    <Color x:Key="Neo.Color.Card.Unknown">#9399B2</Color>

    <!-- ==================== 2. 브러시 ==================== -->
    <SolidColorBrush x:Key="Neo.Brush.Void" Color="{StaticResource Neo.Color.Void}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Neo.Brush.Surface" Color="{StaticResource Neo.Color.Surface}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Neo.Brush.SurfaceRaised" Color="{StaticResource Neo.Color.SurfaceRaised}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Neo.Brush.SurfaceInput" Color="{StaticResource Neo.Color.SurfaceInput}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Neo.Brush.Line" Color="{StaticResource Neo.Color.Line}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Neo.Brush.LineStrong" Color="{StaticResource Neo.Color.LineStrong}" po:Freeze="True"/>

    <SolidColorBrush x:Key="Neo.Brush.Text.Primary" Color="{StaticResource Neo.Color.Text.Primary}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Neo.Brush.Text.Secondary" Color="{StaticResource Neo.Color.Text.Secondary}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Neo.Brush.Text.Muted" Color="{StaticResource Neo.Color.Text.Muted}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Neo.Brush.Text.Dim" Color="{StaticResource Neo.Color.Text.Dim}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Neo.Brush.Text.OnNeon" Color="{StaticResource Neo.Color.Text.OnNeon}" po:Freeze="True"/>

    <SolidColorBrush x:Key="Neo.Brush.Cyan" Color="{StaticResource Neo.Color.Cyan}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Neo.Brush.CyanBright" Color="{StaticResource Neo.Color.CyanBright}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Neo.Brush.Cyan.Soft" Color="#6638BDF8" po:Freeze="True"/>
    <SolidColorBrush x:Key="Neo.Brush.Cyan.Tint" Color="#2638BDF8" po:Freeze="True"/>
    <SolidColorBrush x:Key="Neo.Brush.Rose" Color="{StaticResource Neo.Color.Rose}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Neo.Brush.RoseSoft" Color="{StaticResource Neo.Color.RoseSoft}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Neo.Brush.Rose.Soft" Color="#66F43F75" po:Freeze="True"/>
    <SolidColorBrush x:Key="Neo.Brush.Rose.Tint" Color="#26F43F75" po:Freeze="True"/>
    <SolidColorBrush x:Key="Neo.Brush.Gold" Color="{StaticResource Neo.Color.Gold}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Neo.Brush.Green" Color="{StaticResource Neo.Color.Green}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Neo.Brush.Violet" Color="{StaticResource Neo.Color.Violet}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Neo.Brush.Orange" Color="{StaticResource Neo.Color.Orange}" po:Freeze="True"/>

    <SolidColorBrush x:Key="Neo.Brush.Card.Red" Color="{StaticResource Neo.Color.Card.Red}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Neo.Brush.Card.Blue" Color="{StaticResource Neo.Color.Card.Blue}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Neo.Brush.Card.Yellow" Color="{StaticResource Neo.Color.Card.Yellow}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Neo.Brush.Card.Green" Color="{StaticResource Neo.Color.Card.Green}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Neo.Brush.Card.Black" Color="{StaticResource Neo.Color.Card.Black}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Neo.Brush.Card.Purple" Color="{StaticResource Neo.Color.Card.Purple}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Neo.Brush.Card.White" Color="{StaticResource Neo.Color.Card.White}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Neo.Brush.Card.Unknown" Color="{StaticResource Neo.Color.Card.Unknown}" po:Freeze="True"/>

    <!-- 일체형 사이버 배틀 매트 : 상단 상대(로즈) → 중앙 다크 → 하단 내 진영(시안) -->
    <LinearGradientBrush x:Key="Neo.Brush.Mat" StartPoint="0.5,0" EndPoint="0.5,1" po:Freeze="True">
        <GradientStop Color="#1A0A18" Offset="0"/>
        <GradientStop Color="#0B0C17" Offset="0.38"/>
        <GradientStop Color="#090C15" Offset="0.5"/>
        <GradientStop Color="#0A111D" Offset="0.62"/>
        <GradientStop Color="#061724" Offset="1"/>
    </LinearGradientBrush>

    <!-- 매트 위에 겹쳐 쓰는 디지털 그리드 라인 (40px 타일) -->
    <DrawingBrush x:Key="Neo.Brush.GridLines" TileMode="Tile" Viewport="0,0,40,40" ViewportUnits="Absolute" Stretch="None" po:Freeze="True">
        <DrawingBrush.Drawing>
            <GeometryDrawing Geometry="M0,0 L40,0 M0,0 L0,40">
                <GeometryDrawing.Pen>
                    <Pen Brush="#1438BDF8" Thickness="1"/>
                </GeometryDrawing.Pen>
            </GeometryDrawing>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- 진영 글로우 (필드 영역 배경 위 은은한 발광) -->
    <RadialGradientBrush x:Key="Neo.Brush.Glow.Player" Center="0.5,1" GradientOrigin="0.5,1" RadiusX="0.75" RadiusY="0.9" po:Freeze="True">
        <GradientStop Color="#3338BDF8" Offset="0"/>
        <GradientStop Color="#0038BDF8" Offset="1"/>
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="Neo.Brush.Glow.Opponent" Center="0.5,0" GradientOrigin="0.5,0" RadiusX="0.75" RadiusY="0.9" po:Freeze="True">
        <GradientStop Color="#33F43F75" Offset="0"/>
        <GradientStop Color="#00F43F75" Offset="1"/>
    </RadialGradientBrush>

    <!-- 글래스모피즘 : WPF 에는 백드롭 블러가 없으므로 반투명 그라디언트 + 빛 받는 테두리로 표현 -->
    <LinearGradientBrush x:Key="Neo.Brush.Glass" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Color="{StaticResource Neo.Color.Glass.Top}" Offset="0"/>
        <GradientStop Color="{StaticResource Neo.Color.Glass.Bottom}" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Neo.Brush.Glass.Border" StartPoint="0,0" EndPoint="1,1" po:Freeze="True">
        <GradientStop Color="{StaticResource Neo.Color.Glass.EdgeLight}" Offset="0"/>
        <GradientStop Color="{StaticResource Neo.Color.Glass.EdgeDark}" Offset="0.6"/>
        <GradientStop Color="#26FFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Neo.Brush.Popup" Color="#F2121729" po:Freeze="True"/>

    <!-- 네온 메모리 코어 게이지 : 내 쪽(+10, 좌) 시안 ← 0 → 상대 쪽(-10, 우) 로즈 -->
    <LinearGradientBrush x:Key="Neo.Brush.MemoryCore" StartPoint="0,0.5" EndPoint="1,0.5" po:Freeze="True">
        <GradientStop Color="#38BDF8" Offset="0"/>
        <GradientStop Color="#4038BDF8" Offset="0.42"/>
        <GradientStop Color="#18FFFFFF" Offset="0.5"/>
        <GradientStop Color="#40F43F75" Offset="0.58"/>
        <GradientStop Color="#F43F75" Offset="1"/>
    </LinearGradientBrush>

    <!-- 진영 영역 배경 (글래스 + 진영 색 틴트) -->
    <LinearGradientBrush x:Key="Neo.Brush.Zone.Player" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Color="#A0111A2C" Offset="0"/>
        <GradientStop Color="#B00A1422" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Neo.Brush.Zone.Opponent" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Color="#B0200E1E" Offset="0"/>
        <GradientStop Color="#A0140D1C" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Neo.Brush.Green.Soft" Color="#66A6E3A1" po:Freeze="True"/>
    <SolidColorBrush x:Key="Neo.Brush.Gold.Soft" Color="#66F9E2AF" po:Freeze="True"/>

    <!-- 시안 네온 버튼 표면 -->
    <LinearGradientBrush x:Key="Neo.Brush.Button.Cyan" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Color="#7DE3FF" Offset="0"/>
        <GradientStop Color="#38BDF8" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Neo.Brush.Button.Rose" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Color="#FF7FA3" Offset="0"/>
        <GradientStop Color="#F43F75" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Neo.Brush.Button.Gold" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Color="#FFF1CF" Offset="0"/>
        <GradientStop Color="#F9E2AF" Offset="1"/>
    </LinearGradientBrush>

    <!-- ==================== 3. 네온 글로우 이펙트 ==================== -->
    <DropShadowEffect x:Key="Neo.Glow.Cyan" Color="#38BDF8" ShadowDepth="0" BlurRadius="18" Opacity="0.75" po:Freeze="True"/>
    <DropShadowEffect x:Key="Neo.Glow.Cyan.Soft" Color="#38BDF8" ShadowDepth="0" BlurRadius="26" Opacity="0.35" po:Freeze="True"/>
    <DropShadowEffect x:Key="Neo.Glow.Rose" Color="#F43F75" ShadowDepth="0" BlurRadius="18" Opacity="0.75" po:Freeze="True"/>
    <DropShadowEffect x:Key="Neo.Glow.Rose.Soft" Color="#F43F75" ShadowDepth="0" BlurRadius="26" Opacity="0.35" po:Freeze="True"/>
    <DropShadowEffect x:Key="Neo.Glow.Gold" Color="#F9E2AF" ShadowDepth="0" BlurRadius="20" Opacity="0.8" po:Freeze="True"/>
    <DropShadowEffect x:Key="Neo.Glow.Green" Color="#A6E3A1" ShadowDepth="0" BlurRadius="18" Opacity="0.75" po:Freeze="True"/>
    <DropShadowEffect x:Key="Neo.Shadow.Float" Color="#000000" ShadowDepth="6" Direction="270" BlurRadius="24" Opacity="0.55" po:Freeze="True"/>

    <!-- ==================== 4. 공통 치수 / 폰트 ==================== -->
    <CornerRadius x:Key="Neo.Radius.Small">6</CornerRadius>
    <CornerRadius x:Key="Neo.Radius.Medium">12</CornerRadius>
    <CornerRadius x:Key="Neo.Radius.Large">16</CornerRadius>
    <CornerRadius x:Key="Neo.Radius.Pill">999</CornerRadius>
    <Thickness x:Key="Neo.Border.Neon">1</Thickness>
    <FontFamily x:Key="Neo.Font.Ui">Segoe UI Variable Display, Segoe UI, Malgun Gothic</FontFamily>
    <FontFamily x:Key="Neo.Font.Mono">Cascadia Mono, Consolas, Malgun Gothic</FontFamily>

    <!-- ==================== 5-1. 텍스트 스타일 ==================== -->
    <Style x:Key="Neo.Text.Display" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Neo.Font.Ui}"/>
        <Setter Property="FontSize" Value="28"/>
        <Setter Property="FontWeight" Value="ExtraBold"/>
        <Setter Property="Foreground" Value="{StaticResource Neo.Brush.Text.Primary}"/>
    </Style>
    <Style x:Key="Neo.Text.Title" TargetType="TextBlock" BasedOn="{StaticResource Neo.Text.Display}">
        <Setter Property="FontSize" Value="18"/>
    </Style>
    <Style x:Key="Neo.Text.Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Neo.Font.Ui}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Foreground" Value="{StaticResource Neo.Brush.Text.Secondary}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="Neo.Text.Muted" TargetType="TextBlock" BasedOn="{StaticResource Neo.Text.Body}">
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="Foreground" Value="{StaticResource Neo.Brush.Text.Muted}"/>
    </Style>
    <!-- 섹션 라벨 (예: "MODE 01 · OFFICIAL AI DUEL") -->
    <Style x:Key="Neo.Text.Label" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Neo.Font.Ui}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource Neo.Brush.Cyan}"/>
    </Style>
    <!-- 숫자 HUD (DP, 메모리, 덱 매수) -->
    <Style x:Key="Neo.Text.Stat" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Neo.Font.Mono}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource Neo.Brush.Text.Primary}"/>
    </Style>

    <!-- ==================== 5-2. 패널 스타일 (Border) ==================== -->
    <Style x:Key="Neo.Panel.Glass" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Neo.Brush.Glass}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Neo.Brush.Glass.Border}"/>
        <Setter Property="BorderThickness" Value="{StaticResource Neo.Border.Neon}"/>
        <Setter Property="CornerRadius" Value="{StaticResource Neo.Radius.Large}"/>
        <Setter Property="Padding" Value="14"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>
    <!-- 내 진영 영역 (시안 네온 보더 + 틴트)
         ※ DropShadowEffect 는 자식(카드·텍스트)까지 번지므로 내용이 있는 패널에는 Effect 를 넣지 않는다.
            글로우가 필요하면 자식 없는 장식용 Border 를 뒤에 겹쳐서 Neo.Glow.* 를 적용할 것. -->
    <Style x:Key="Neo.Panel.Player" TargetType="Border" BasedOn="{StaticResource Neo.Panel.Glass}">
        <Setter Property="Background" Value="{StaticResource Neo.Brush.Zone.Player}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Neo.Brush.Cyan.Soft}"/>
        <Setter Property="Padding" Value="10,7"/>
    </Style>
    <!-- 상대 진영 영역 (로즈 네온 보더 + 틴트) -->
    <Style x:Key="Neo.Panel.Opponent" TargetType="Border" BasedOn="{StaticResource Neo.Panel.Glass}">
        <Setter Property="Background" Value="{StaticResource Neo.Brush.Zone.Opponent}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Neo.Brush.Rose.Soft}"/>
        <Setter Property="Padding" Value="10,7"/>
    </Style>
    <!-- 영역 헤더 라벨 -->
    <Style x:Key="Neo.Text.ZoneTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Neo.Font.Ui}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="ExtraBold"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{StaticResource Neo.Brush.Cyan}"/>
    </Style>
    <!-- 플로팅 인스펙터 / 팝오버 -->
    <Style x:Key="Neo.Panel.Floating" TargetType="Border" BasedOn="{StaticResource Neo.Panel.Glass}">
        <Setter Property="Background" Value="{StaticResource Neo.Brush.Popup}"/>
        <Setter Property="Effect" Value="{StaticResource Neo.Shadow.Float}"/>
    </Style>
    <!-- 패널 안쪽의 움푹 들어간 영역 (리스트, 로그) -->
    <Style x:Key="Neo.Panel.Inset" TargetType="Border">
        <Setter Property="Background" Value="#990A0D18"/>
        <Setter Property="BorderBrush" Value="{StaticResource Neo.Brush.Line}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource Neo.Radius.Medium}"/>
        <Setter Property="Padding" Value="10"/>
    </Style>
    <!-- 필드 카드 슬롯 (점선 네온 대신 얇은 보더 + 틴트) -->
    <Style x:Key="Neo.Panel.Slot" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Neo.Brush.Cyan.Tint}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Neo.Brush.Cyan.Soft}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource Neo.Radius.Medium}"/>
    </Style>
    <Style x:Key="Neo.Panel.Slot.Opponent" TargetType="Border" BasedOn="{StaticResource Neo.Panel.Slot}">
        <Setter Property="Background" Value="{StaticResource Neo.Brush.Rose.Tint}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Neo.Brush.Rose.Soft}"/>
    </Style>
    <!-- 칩 / 배지 -->
    <Style x:Key="Neo.Chip" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Neo.Brush.Cyan.Tint}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Neo.Brush.Cyan.Soft}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource Neo.Radius.Pill}"/>
        <Setter Property="Padding" Value="10,3"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>

    <!-- ==================== 6-1. Button ==================== -->
    <!-- 기본 버튼 : 기존 Background/BorderBrush 값을 그대로 쓰되 Aero 크롬 대신 라운드 + 호버 하이라이트 + 눌림 스케일 -->
    <Style x:Key="Neo.Button.Base" TargetType="Button">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="FontFamily" Value="{StaticResource Neo.Font.Ui}"/>
        <Setter Property="Background" Value="{StaticResource Neo.Brush.SurfaceRaised}"/>
        <Setter Property="Foreground" Value="{StaticResource Neo.Brush.Text.Secondary}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Neo.Brush.Line}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="themes:ThemeAssist.CornerRadius" Value="8"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding themes:ThemeAssist.CornerRadius}"/>
                        <Border x:Name="Highlight" Background="#FFFFFF" Opacity="0"
                                CornerRadius="{TemplateBinding themes:ThemeAssist.CornerRadius}"/>
                        <Border x:Name="FocusRing" BorderBrush="{StaticResource Neo.Brush.Cyan}" BorderThickness="1.5" Opacity="0"
                                CornerRadius="{TemplateBinding themes:ThemeAssist.CornerRadius}"/>
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True"
                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Highlight" Property="Opacity" Value="0.1"/>
                            <Setter TargetName="Root" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="1.02" ScaleY="1.02"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Highlight" Property="Opacity" Value="0.18"/>
                            <Setter TargetName="Root" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.97" ScaleY="0.97"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusRing" Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 앱 전체 버튼에 암시적으로 적용 -->
    <Style TargetType="Button" BasedOn="{StaticResource Neo.Button.Base}"/>

    <!-- 시안 네온 (내 진영 주요 액션: 대련 시작, 턴 종료 등) -->
    <Style x:Key="Neo.Button.Primary" TargetType="Button" BasedOn="{StaticResource Neo.Button.Base}">
        <Setter Property="Background" Value="{StaticResource Neo.Brush.Button.Cyan}"/>
        <Setter Property="Foreground" Value="{StaticResource Neo.Brush.Text.OnNeon}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontWeight" Value="ExtraBold"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Effect" Value="{StaticResource Neo.Glow.Cyan}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <!-- 로즈 네온 (공격 / 위험 액션) -->
    <Style x:Key="Neo.Button.Danger" TargetType="Button" BasedOn="{StaticResource Neo.Button.Primary}">
        <Setter Property="Background" Value="{StaticResource Neo.Brush.Button.Rose}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Effect" Value="{StaticResource Neo.Glow.Rose}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <!-- 골드 (강조 / 보상) -->
    <Style x:Key="Neo.Button.Gold" TargetType="Button" BasedOn="{StaticResource Neo.Button.Primary}">
        <Setter Property="Background" Value="{StaticResource Neo.Brush.Button.Gold}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Effect" Value="{StaticResource Neo.Glow.Gold}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <!-- 고스트 (투명 배경 + 1px 네온 보더 : 내비게이션 / 보조 액션) -->
    <Style x:Key="Neo.Button.Ghost" TargetType="Button" BasedOn="{StaticResource Neo.Button.Base}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource Neo.Brush.Text.Secondary}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Neo.Brush.Glass.Border}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Neo.Brush.CyanBright}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Neo.Brush.Cyan}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <!-- 프리셋 칩 (퀵 덱 셀렉터) : Background 에 덱 색상을 지정해서 사용 -->
    <Style x:Key="Neo.Button.Chip" TargetType="Button" BasedOn="{StaticResource Neo.Button.Base}">
        <Setter Property="Foreground" Value="{StaticResource Neo.Brush.Text.OnNeon}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="themes:ThemeAssist.CornerRadius" Value="999"/>
    </Style>

    <!-- ==================== 6-2. ToolTip ==================== -->
    <Style TargetType="ToolTip">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="HasDropShadow" Value="True"/>
        <Setter Property="FontFamily" Value="{StaticResource Neo.Font.Ui}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource Neo.Brush.Text.Primary}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{StaticResource Neo.Brush.Popup}" BorderBrush="{StaticResource Neo.Brush.Cyan.Soft}" BorderThickness="1"
                            CornerRadius="8" Padding="10,6" MaxWidth="420">
                        <ContentPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== 6-3. ScrollBar (얇은 네온 스크롤바) ==================== -->
    <Style x:Key="Neo.ScrollBar.PageButton" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Neo.ScrollBar.Thumb" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="ThumbBody" Background="{StaticResource Neo.Brush.LineStrong}" CornerRadius="4"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ThumbBody" Property="Background" Value="{StaticResource Neo.Brush.Cyan.Soft}"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="ThumbBody" Property="Background" Value="{StaticResource Neo.Brush.Cyan}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ScrollBar">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="8"/>
        <Setter Property="MinWidth" Value="8"/>
        <Setter Property="Height" Value="Auto"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Border Background="{TemplateBinding Background}" CornerRadius="4">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource Neo.ScrollBar.PageButton}" Command="ScrollBar.PageUpCommand"/>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource Neo.ScrollBar.Thumb}" Margin="1,2"/>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource Neo.ScrollBar.PageButton}" Command="ScrollBar.PageDownCommand"/>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="Height" Value="8"/>
                <Setter Property="MinHeight" Value="8"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                <Track x:Name="PART_Track" IsDirectionReversed="False">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource Neo.ScrollBar.PageButton}" Command="ScrollBar.PageLeftCommand"/>
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource Neo.ScrollBar.Thumb}" Margin="2,1"/>
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource Neo.ScrollBar.PageButton}" Command="ScrollBar.PageRightCommand"/>
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ==================== 6-4. ComboBox (다크 글래스 드롭다운) ==================== -->
    <ControlTemplate x:Key="Neo.ComboBox.Toggle" TargetType="ToggleButton">
        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
            <Path x:Name="Arrow" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"
                  Data="M0,0 L4,4 L8,0" Stroke="{StaticResource Neo.Brush.Text.Muted}" StrokeThickness="1.5"/>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Neo.Brush.Cyan.Soft}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Neo.Brush.Cyan}"/>
                <Setter TargetName="Arrow" Property="Stroke" Value="{StaticResource Neo.Brush.Cyan}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="Neo.ComboBoxItem" TargetType="ComboBoxItem">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Foreground" Value="{StaticResource Neo.Brush.Text.Secondary}"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Neo.Brush.Cyan.Tint}"/>
                            <Setter Property="Foreground" Value="{StaticResource Neo.Brush.Text.Primary}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Neo.Brush.CyanBright}"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource Neo.Brush.Text.Dim}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Neo.ComboBox" TargetType="ComboBox">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="FontFamily" Value="{StaticResource Neo.Font.Ui}"/>
        <Setter Property="Background" Value="{StaticResource Neo.Brush.SurfaceInput}"/>
        <Setter Property="Foreground" Value="{StaticResource Neo.Brush.Text.Primary}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Neo.Brush.LineStrong}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="MinHeight" Value="26"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource Neo.ComboBoxItem}"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid SnapsToDevicePixels="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="26"/>
                        </Grid.ColumnDefinitions>
                        <ToggleButton x:Name="ToggleButton" Grid.ColumnSpan="2"
                                      Template="{StaticResource Neo.ComboBox.Toggle}"
                                      Background="{TemplateBinding Background}"
                                      BorderBrush="{TemplateBinding BorderBrush}"
                                      BorderThickness="{TemplateBinding BorderThickness}"
                                      Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                        <ContentPresenter x:Name="ContentSite" Grid.Column="0" IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" HorizontalAlignment="Left"/>
                        <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                            <Border x:Name="DropDownBorder" Margin="0,4,0,0"
                                    Background="{StaticResource Neo.Brush.Popup}"
                                    BorderBrush="{StaticResource Neo.Brush.Cyan.Soft}" BorderThickness="1" CornerRadius="8"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <ScrollViewer Margin="4" SnapsToDevicePixels="True">
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasItems" Value="False">
                            <Setter TargetName="DropDownBorder" Property="MinHeight" Value="40"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 앱 전체 ComboBox 에 암시적으로 적용 (기본 라이트 크롬이 다크 UI 와 충돌하므로) -->
    <Style TargetType="ComboBox" BasedOn="{StaticResource Neo.ComboBox}"/>

    <!-- ==================== 6-5. TextBox (다크 입력창, 암시적 적용) ==================== -->
    <Style TargetType="TextBox">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="FontFamily" Value="{StaticResource Neo.Font.Ui}"/>
        <Setter Property="Background" Value="{StaticResource Neo.Brush.SurfaceInput}"/>
        <Setter Property="Foreground" Value="{StaticResource Neo.Brush.Text.Primary}"/>
        <Setter Property="CaretBrush" Value="{StaticResource Neo.Brush.Cyan}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource Neo.Brush.Cyan}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Neo.Brush.LineStrong}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Neo.Brush.Cyan.Soft}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Neo.Brush.Cyan}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== 6-6. ProgressBar (네온 바, 키 지정) ==================== -->
    <Style x:Key="Neo.ProgressBar" TargetType="ProgressBar">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Background" Value="{StaticResource Neo.Brush.Line}"/>
        <Setter Property="Foreground" Value="{StaticResource Neo.Brush.Cyan}"/>
        <Setter Property="Height" Value="6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="3"/>
                        <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="3"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
