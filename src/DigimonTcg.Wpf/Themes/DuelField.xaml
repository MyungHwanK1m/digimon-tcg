<!--
    ============================================================================================
     DUEL FIELD 테마 (유희왕 마스터 듀얼 스타일 대련장)
     - 위/아래로 거울처럼 마주 보는 두 개의 듀얼 매트 (상대: 로즈 엣지 / 나: 시안 엣지)
     - 매트 위에 각인된 카드 존 슬롯 (배틀 존 = 몬스터 존, 테이머 존 = 마법·함정 존, 덱 / 트래시 / 시큐리티 / 육성 존)
     - 두 매트 사이의 발광 듀얼 라인 (메모리 게이지 + 페이즈 + 턴 종료)
     - 모서리의 플레이어 플레이트 (아바타 링 + 시큐리티 수 = 유희왕 LP 표시 위치)
     CyberNeo.xaml 의 색상/브러시를 그대로 사용하므로 App.xaml 에서 CyberNeo.xaml 다음에 병합한다.
     키 규칙: Duel.{분류}.{이름}
    ============================================================================================
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    mc:Ignorable="po">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="CyberNeo.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- ==================== 브러시 ==================== -->
    <!-- 대련장 전체 바닥 (스포트라이트가 중앙 듀얼 라인에 떨어지는 느낌) -->
    <RadialGradientBrush x:Key="Duel.Brush.Arena" Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.75" RadiusY="0.8" po:Freeze="True">
        <GradientStop Color="#141C33" Offset="0"/>
        <GradientStop Color="#0A0F1E" Offset="0.55"/>
        <GradientStop Color="#04060C" Offset="1"/>
    </RadialGradientBrush>

    <!-- 매트 표면 각인 패턴 (마름모 타일) -->
    <DrawingBrush x:Key="Duel.Brush.MatPattern" TileMode="Tile" Viewport="0,0,28,28" ViewportUnits="Absolute" Stretch="None" po:Freeze="True">
        <DrawingBrush.Drawing>
            <GeometryDrawing Geometry="M14,0 L28,14 L14,28 L0,14 Z">
                <GeometryDrawing.Pen>
                    <Pen Brush="#0CFFFFFF" Thickness="1"/>
                </GeometryDrawing.Pen>
            </GeometryDrawing>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- 내 매트: 바깥쪽(아래) 가장자리로 갈수록 시안 발광 -->
    <LinearGradientBrush x:Key="Duel.Brush.Mat.Player" StartPoint="0.5,0" EndPoint="0.5,1" po:Freeze="True">
        <GradientStop Color="#E00D1527" Offset="0"/>
        <GradientStop Color="#E00B1424" Offset="0.7"/>
        <GradientStop Color="#E0082236" Offset="1"/>
    </LinearGradientBrush>
    <!-- 상대 매트: 바깥쪽(위) 가장자리로 갈수록 로즈 발광 -->
    <LinearGradientBrush x:Key="Duel.Brush.Mat.Opponent" StartPoint="0.5,0" EndPoint="0.5,1" po:Freeze="True">
        <GradientStop Color="#E0280C22" Offset="0"/>
        <GradientStop Color="#E0160D1E" Offset="0.3"/>
        <GradientStop Color="#E0110F1F" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Duel.Brush.MatEdge.Player" StartPoint="0.5,0" EndPoint="0.5,1" po:Freeze="True">
        <GradientStop Color="#3038BDF8" Offset="0"/>
        <GradientStop Color="#CC38BDF8" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Duel.Brush.MatEdge.Opponent" StartPoint="0.5,0" EndPoint="0.5,1" po:Freeze="True">
        <GradientStop Color="#CCF43F75" Offset="0"/>
        <GradientStop Color="#30F43F75" Offset="1"/>
    </LinearGradientBrush>

    <!-- 카드 존 슬롯 -->
    <LinearGradientBrush x:Key="Duel.Brush.ZoneFill" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Color="#16FFFFFF" Offset="0"/>
        <GradientStop Color="#06FFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Duel.Brush.ZoneEdge.Player" Color="#7038BDF8" po:Freeze="True"/>
    <SolidColorBrush x:Key="Duel.Brush.ZoneEdge.Opponent" Color="#70F43F75" po:Freeze="True"/>
    <SolidColorBrush x:Key="Duel.Brush.ZoneEdge.Neutral" Color="#40FFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="Duel.Brush.ZoneLabel" Color="#66CDD6F4" po:Freeze="True"/>

    <!-- 플레이트 금속 테두리 (골드) -->
    <SolidColorBrush x:Key="Duel.Brush.Gold" Color="#E8C77A" po:Freeze="True"/>
    <LinearGradientBrush x:Key="Duel.Brush.GoldEdge" StartPoint="0,0" EndPoint="1,1" po:Freeze="True">
        <GradientStop Color="#FFF1CF" Offset="0"/>
        <GradientStop Color="#B8913F" Offset="0.5"/>
        <GradientStop Color="#E8C77A" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Duel.Brush.Plate" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Color="#F21A2138" Offset="0"/>
        <GradientStop Color="#F20B0F1C" Offset="1"/>
    </LinearGradientBrush>

    <!-- 중앙 듀얼 라인 -->
    <LinearGradientBrush x:Key="Duel.Brush.DuelLine" StartPoint="0,0.5" EndPoint="1,0.5" po:Freeze="True">
        <GradientStop Color="#0038BDF8" Offset="0"/>
        <GradientStop Color="#9938BDF8" Offset="0.3"/>
        <GradientStop Color="#EEFFFFFF" Offset="0.5"/>
        <GradientStop Color="#99F43F75" Offset="0.7"/>
        <GradientStop Color="#00F43F75" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Duel.Brush.DuelBand" StartPoint="0.5,0" EndPoint="0.5,1" po:Freeze="True">
        <GradientStop Color="#00060A14" Offset="0"/>
        <GradientStop Color="#E0060A14" Offset="0.25"/>
        <GradientStop Color="#E0060A14" Offset="0.75"/>
        <GradientStop Color="#00060A14" Offset="1"/>
    </LinearGradientBrush>

    <!-- 카드 뒷면 -->
    <LinearGradientBrush x:Key="Duel.Brush.CardBack" StartPoint="0,0" EndPoint="1,1" po:Freeze="True">
        <GradientStop Color="#1E3A8A" Offset="0"/>
        <GradientStop Color="#0F172A" Offset="0.6"/>
        <GradientStop Color="#312E81" Offset="1"/>
    </LinearGradientBrush>

    <!-- ==================== TCG 카드 뒷면 ==================== -->
    <!-- 뒷면 바탕의 디지털 회로 패턴 -->
    <DrawingBrush x:Key="Duel.Brush.CardBackCircuit" TileMode="Tile" Viewport="0,0,40,40" ViewportUnits="Absolute" Stretch="None" po:Freeze="True">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Geometry="M0,20 H13 L20,13 V0 M40,27 H28 L22,33 V40 M27,0 V8 L33,14 H40">
                    <GeometryDrawing.Pen>
                        <Pen Brush="#3038BDF8" Thickness="1.2"/>
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Brush="#5538BDF8" Geometry="M11,18 A2,2 0 1 1 15,18 A2,2 0 1 1 11,18 M26,31 A2,2 0 1 1 30,31 A2,2 0 1 1 26,31"/>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <LinearGradientBrush x:Key="Duel.Brush.LogoFill" StartPoint="0.5,0" EndPoint="0.5,1" po:Freeze="True">
        <GradientStop Color="#FFF6A0" Offset="0"/>
        <GradientStop Color="#FFB020" Offset="0.5"/>
        <GradientStop Color="#E8590C" Offset="1"/>
    </LinearGradientBrush>

    <!-- 메인 덱 카드 뒷면 (세로, 250 x 350 기준으로 그린 뒤 어떤 크기에도 늘려 씀) -->
    <VisualBrush x:Key="Duel.Brush.CardBackArt" Stretch="Fill">
        <VisualBrush.Visual>
            <Grid Width="250" Height="350">
                <Border CornerRadius="14">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#1A5BC8" Offset="0"/>
                            <GradientStop Color="#0A2C74" Offset="0.45"/>
                            <GradientStop Color="#061845" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <Border CornerRadius="14" Background="{StaticResource Duel.Brush.CardBackCircuit}"/>
                <Ellipse Width="320" Height="320">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#7038BDF8" Offset="0"/>
                            <GradientStop Color="#0038BDF8" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Border Margin="10" CornerRadius="9" BorderBrush="#F2FFFFFF" BorderThickness="4"/>
                <Border Margin="19" CornerRadius="6" BorderBrush="#6638BDF8" BorderThickness="1.5"/>
                <TextBlock Text="◆  ◆  ◆" Foreground="#9938BDF8" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,34,0,0"/>
                <TextBlock Text="◆  ◆  ◆" Foreground="#9938BDF8" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,34"/>
                <!-- 로고 엠블럼 -->
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid.RenderTransform>
                        <RotateTransform Angle="-12" CenterX="100" CenterY="50"/>
                    </Grid.RenderTransform>
                    <Ellipse Width="204" Height="104" Fill="#E0041035" Stroke="{StaticResource Duel.Brush.LogoFill}" StrokeThickness="4"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="DIGIMON" FontFamily="Arial Black" FontWeight="Black" FontSize="36" Foreground="{StaticResource Duel.Brush.LogoFill}" HorizontalAlignment="Center">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="#000000" ShadowDepth="3" Direction="300" BlurRadius="0" Opacity="0.9"/>
                            </TextBlock.Effect>
                        </TextBlock>
                        <TextBlock Text="CARD GAME" FontFamily="Arial" FontWeight="Bold" FontSize="13" Foreground="White" HorizontalAlignment="Center" Margin="0,-2,0,0"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </VisualBrush.Visual>
    </VisualBrush>

    <!-- 시큐리티처럼 가로로 눕혀 놓는 카드 뒷면 -->
    <VisualBrush x:Key="Duel.Brush.CardBackArt.Sideways" Stretch="Fill">
        <VisualBrush.Visual>
            <Rectangle Width="250" Height="350" Fill="{StaticResource Duel.Brush.CardBackArt}">
                <Rectangle.LayoutTransform>
                    <RotateTransform Angle="90"/>
                </Rectangle.LayoutTransform>
            </Rectangle>
        </VisualBrush.Visual>
    </VisualBrush>

    <!-- 디지타마 덱 카드 뒷면 -->
    <VisualBrush x:Key="Duel.Brush.EggBackArt" Stretch="Fill">
        <VisualBrush.Visual>
            <Grid Width="250" Height="350">
                <Border CornerRadius="14">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#2F8F5B" Offset="0"/>
                            <GradientStop Color="#145238" Offset="0.5"/>
                            <GradientStop Color="#0A2A1E" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <Border CornerRadius="14" Background="{StaticResource Duel.Brush.CardBackCircuit}" Opacity="0.7"/>
                <Border Margin="10" CornerRadius="9" BorderBrush="#F2FFFFFF" BorderThickness="4"/>
                <!-- 디지타마 (알) -->
                <Ellipse Width="120" Height="156" VerticalAlignment="Center" Margin="0,0,0,40" Stroke="#F2FFFFFF" StrokeThickness="4">
                    <Ellipse.Fill>
                        <RadialGradientBrush GradientOrigin="0.35,0.3">
                            <GradientStop Color="#FFFDF0" Offset="0"/>
                            <GradientStop Color="#F9E2AF" Offset="0.55"/>
                            <GradientStop Color="#D9A441" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Path Data="M98,128 C108,118 116,140 128,124 C136,114 146,134 154,122" Stroke="#E8590C" StrokeThickness="5" Margin="0,0,0,40"/>
                <StackPanel VerticalAlignment="Bottom" Margin="0,0,0,42">
                    <TextBlock Text="DIGI-EGG" FontFamily="Arial Black" FontWeight="Black" FontSize="32" Foreground="{StaticResource Duel.Brush.LogoFill}" HorizontalAlignment="Center">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="#000000" ShadowDepth="3" Direction="300" BlurRadius="0" Opacity="0.9"/>
                        </TextBlock.Effect>
                    </TextBlock>
                    <TextBlock Text="DIGIMON CARD GAME" FontFamily="Arial" FontWeight="Bold" FontSize="12" Foreground="White" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </VisualBrush.Visual>
    </VisualBrush>

    <!-- ==================== 덱 빌더 바인더 앨범 ==================== -->
    <!-- 바인더 페이지 (짙은 가죽 + 스티치) -->
    <LinearGradientBrush x:Key="Duel.Brush.Binder" StartPoint="0,0" EndPoint="1,1" po:Freeze="True">
        <GradientStop Color="#E6141A2E" Offset="0"/>
        <GradientStop Color="#E60C1120" Offset="0.6"/>
        <GradientStop Color="#E6101628" Offset="1"/>
    </LinearGradientBrush>
    <!-- 카드 슬리브 비닐 광택 -->
    <LinearGradientBrush x:Key="Duel.Brush.SleeveSheen" StartPoint="0,0" EndPoint="1,1" po:Freeze="True">
        <GradientStop Color="#40FFFFFF" Offset="0"/>
        <GradientStop Color="#08FFFFFF" Offset="0.35"/>
        <GradientStop Color="#00FFFFFF" Offset="0.6"/>
        <GradientStop Color="#14FFFFFF" Offset="1"/>
    </LinearGradientBrush>

    <!-- ==================== 스타일 ==================== -->
    <!-- 메인 로비(타이틀 화면) 세로 메뉴 버튼: BorderBrush = 왼쪽 강조 바 색, 호버 시 오른쪽으로 밀리며 밝아짐 -->
    <Style x:Key="Lobby.MenuButton" TargetType="Button">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Width" Value="440"/>
        <Setter Property="Height" Value="74"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontFamily" Value="{StaticResource Neo.Font.Ui}"/>
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontWeight" Value="ExtraBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" Background="Transparent">
                        <Grid.RenderTransform>
                            <TranslateTransform x:Name="Slide" X="0"/>
                        </Grid.RenderTransform>
                        <Border x:Name="Plate" CornerRadius="4,14,14,4" BorderThickness="1" BorderBrush="#33FFFFFF">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                    <GradientStop Color="#CC0B1222" Offset="0"/>
                                    <GradientStop Color="#660B1222" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Border x:Name="Accent" Width="6" HorizontalAlignment="Left" CornerRadius="4,0,0,4" Background="{TemplateBinding BorderBrush}"/>
                        <Border x:Name="Glow" CornerRadius="4,14,14,4" Background="{TemplateBinding BorderBrush}" Opacity="0"/>
                        <ContentPresenter Margin="30,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <TextBlock x:Name="Arrow" Text="▶" FontSize="16" Foreground="{TemplateBinding BorderBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,24,0" Opacity="0.35"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Glow" Property="Opacity" Value="0.18"/>
                            <Setter TargetName="Arrow" Property="Opacity" Value="1"/>
                            <Setter TargetName="Accent" Property="Width" Value="10"/>
                            <Setter TargetName="Plate" Property="BorderBrush" Value="{Binding BorderBrush, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <Setter TargetName="Root" Property="RenderTransform">
                                <Setter.Value>
                                    <TranslateTransform X="12"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Glow" Property="Opacity" Value="0.32"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 메인 로비 모드 카드 (호버 시 살짝 떠오름) -->
    <Style x:Key="Lobby.ModeCard" TargetType="Border">
        <Setter Property="CornerRadius" Value="18"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="ClipToBounds" Value="True"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="Effect" Value="{StaticResource Neo.Shadow.Float}"/>
        <Setter Property="RenderTransform">
            <Setter.Value>
                <ScaleTransform ScaleX="1" ScaleY="1"/>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="RenderTransform">
                    <Setter.Value>
                        <ScaleTransform ScaleX="1.015" ScaleY="1.015"/>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>
    <!-- 듀얼 매트 (한쪽 진영 전체 판) -->
    <Style x:Key="Duel.Mat" TargetType="Border">
        <Setter Property="CornerRadius" Value="18"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>
    <Style x:Key="Duel.Mat.Player" TargetType="Border" BasedOn="{StaticResource Duel.Mat}">
        <Setter Property="Background" Value="{StaticResource Duel.Brush.Mat.Player}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Duel.Brush.MatEdge.Player}"/>
    </Style>
    <Style x:Key="Duel.Mat.Opponent" TargetType="Border" BasedOn="{StaticResource Duel.Mat}">
        <Setter Property="Background" Value="{StaticResource Duel.Brush.Mat.Opponent}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Duel.Brush.MatEdge.Opponent}"/>
    </Style>

    <!-- 매트 위 각인된 카드 존 (덱 / 트래시 / 시큐리티 / 육성 / 배틀 / 테이머) -->
    <Style x:Key="Duel.Zone" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Duel.Brush.ZoneFill}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Duel.Brush.ZoneEdge.Player}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>
    <Style x:Key="Duel.Zone.Opponent" TargetType="Border" BasedOn="{StaticResource Duel.Zone}">
        <Setter Property="BorderBrush" Value="{StaticResource Duel.Brush.ZoneEdge.Opponent}"/>
    </Style>

    <!-- 존 이름 각인 텍스트 (예: "BATTLE ZONE", "TRASH") -->
    <Style x:Key="Duel.ZoneLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Neo.Font.Mono}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource Duel.Brush.ZoneLabel}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- 대련장 좌측 설명 패널 섹션 -->
    <Style x:Key="Duel.SidePanel" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Neo.Brush.Popup}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Neo.Brush.Line}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="12,9"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>
    <Style x:Key="Duel.SidePanelTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Neo.Font.Ui}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontWeight" Value="ExtraBold"/>
        <Setter Property="Foreground" Value="{StaticResource Neo.Brush.Cyan}"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>
    <Style x:Key="Duel.GuideLine" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Neo.Font.Ui}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{StaticResource Neo.Brush.Text.Secondary}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="LineHeight" Value="16"/>
        <Setter Property="Margin" Value="0,0,0,7"/>
    </Style>

    <!-- 플레이어 플레이트 (유희왕 LP 표시 자리) -->
    <Style x:Key="Duel.Plate" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Duel.Brush.Plate}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Duel.Brush.GoldEdge}"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="Effect" Value="{StaticResource Neo.Shadow.Float}"/>
    </Style>
    <!-- 플레이트 안의 큰 숫자 (시큐리티 수) -->
    <Style x:Key="Duel.PlateNumber" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Neo.Font.Mono}"/>
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontWeight" Value="ExtraBold"/>
        <Setter Property="Foreground" Value="{StaticResource Neo.Brush.Text.Primary}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

</ResourceDictionary>
